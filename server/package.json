{
	"name": "@blinkbase/server",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_ENV=production rspack build",
		"dev": "cross-env NODE_ENV=development rspack --watch",
		"lint:sql": "sqlfluff lint -d postgres sql",
		"migrate": "dotenvx run -- cross-env-shell migrate -path _sql -database $DB_URL up",
		"migrate:create": "migrate create -dir _sql -ext sql -seq",
		"test": "vitest"
	},
	"dependencies": {
		"@napi-rs/canvas": "0.1.96",
		"@orpc/server": "catalog:orpc",
		"bcrypt": "6.0.0",
		"dotenv": "17.3.1",
		"jsonwebtoken": "9.0.3",
		"pg": "8.20.0",
		"zod": "catalog:validation"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "1.55.1",
		"@rspack/cli": "1.7.8",
		"@rspack/core": "1.7.8",
		"@types/bcrypt": "6.0.0",
		"@types/jsonwebtoken": "9.0.10",
		"@types/pg": "8.18.0",
		"@xcamp/webpack": "2026.3.3",
		"cross-env": "10.1.0",
		"ts-loader": "9.5.4",
		"typescript": "5.9.3",
		"webpack": "5.105.4",
		"webpack-merge": "6.0.1"
	}
}
